{
  "terraform": {
    "required_providers": {
      "aws": {
        "source": "hashicorp/aws"
      }
    }
  },
  "provider": {
    "aws": [
      {
        "region": "us-east-1"
      }
    ]
  },
  "resource": {
    "aws_s3_bucket": {
      "assets": {
        "bucket": "cdktf-assets",
        "acl": "public-read"
      }
    },
    "aws_instance": {
      "web": {
        "ami": "ami-0abcdef1234567890",
        "instance_type": "t3.micro"
      }
    }
  }
}
